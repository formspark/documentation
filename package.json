{
  "name": "formspark-documentation",
  "description": "Formspark documentation",
  "private": true,
  "version": "1.0.0",
  "author": "Bjorn Krols (https://formspark.io)",
  "license": "UNLICENSED",
  "keywords": [
    "documentation",
    "forms",
    "formspark"
  ],
  "authors": {
    "name": "Formspark",
    "email": "support@formspark.io"
  },
  "homepage": "https://github.com/formspark/documentation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formspark/documentation.git"
  },
  "bugs": {
    "url": "https://github.com/formspark/documentation/issues"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm test && vitepress build docs",
    "deploy": "aws s3 sync docs/.vitepress/dist s3://formspark-documentation-website --delete --region eu-west-1 && aws cloudfront create-invalidation --distribution-id E85HAKX4CBCUB --paths \"/*\" --region eu-west-1",
    "dev": "vitepress dev docs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "prepare": "husky",
    "test": "node --test scripts/sentry-privacy.test.mjs"
  },
  "dependencies": {
    "@sentry/vue": "^10.70.0"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "prettier": "^3.0.0",
    "pretty-quick": "^4.0.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@11.17.0"
}
